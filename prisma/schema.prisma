generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id         String   @id @default(cuid())
  shop       String
  shopifyId  String   @unique
  title      String
  status     String?
  price      String?
  sku        String?
  inventory  Int?
  images     String?   // ✅ changed from Json to String
  raw        String?   // ✅ changed from Json to String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
model TikTokAuth {
  id           String   @id @default(cuid())
  accessToken  String
  refreshToken String?
  tokenType    String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
model AdPerformance {
  id          Int    @id @default(autoincrement())
  adId        String @unique   // upsert key used in lib/tiktok.ts
  adName      String
  status      String?
  spend       Float  @default(0)
  impressions Int    @default(0)
  clicks      Int    @default(0)
  ctr         Float  @default(0)
  conversions Int    @default(0)
  dateFrom    DateTime?
  dateTo      DateTime?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}
